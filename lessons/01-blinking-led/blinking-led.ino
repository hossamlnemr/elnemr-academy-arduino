// أكاديمية النمر — الدرس ١: لمبة بتومض 💡
// أول مشروع: setup بتشتغل مرة واحدة، و loop بتتكرر للأبد
// التوصيل: لمبة ليد — الرجل الطويلة (+) بمقاومة وبعدها منفذ 13، والقصيرة (−) للمنفذ GND
// (ممكن تستخدم لمبة اللوحة نفسها على منفذ 13 من غير توصيل)

void setup() {
  pinMode(13, OUTPUT);
}

void loop() {
  digitalWrite(13, HIGH);   // نوّر
  delay(1000);              // استنى ثانية
  digitalWrite(13, LOW);    // اطفي
  delay(1000);              // استنى ثانية
}

// التحدي: غيّر رقم الانتظار من 1000 إلى 333 — هل اللمبة بقت أسرع ولا أبطأ؟
