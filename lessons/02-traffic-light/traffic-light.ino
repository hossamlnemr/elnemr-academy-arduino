// أكاديمية النمر — الدرس ٢: إشارة مرور كاملة 🚦
// الأردوينو بينفّذ الأوامر واحد ورا التاني بالترتيب، زي إشارة المرور الحقيقية
// التوصيل: الحمرا ← منفذ 10، الصفرا ← منفذ 9، الخضرا ← منفذ 8
// (كل لمبة بمقاومة، وكل الأرجل القصيرة على خط GND المشترك)

void setup() {
  pinMode(10, OUTPUT);   // الحمرا
  pinMode(9, OUTPUT);    // الصفرا
  pinMode(8, OUTPUT);    // الخضرا
}

void loop() {
  digitalWrite(8, HIGH); delay(3000); digitalWrite(8, LOW);     // خضرا 3 ثواني
  digitalWrite(9, HIGH); delay(1000); digitalWrite(9, LOW);     // صفرا ثانية
  digitalWrite(10, HIGH); delay(3000); digitalWrite(10, LOW);   // حمرا 3 ثواني
}

// التحدي: غيّر وقت الصفرا من ثانية إلى 3 ثواني، وبعدها اعمل إشارة بتومض أحمر بس، زي إشارات الطريق بالليل
